# Go Cloud Server Environment Configuration

# The port the server will listen on (defaults to 8080 if empty)
PORT=8080

# The API URL of your Supabase project REST endpoint (e.g., https://xyz.supabase.co)
SUPABASE_URL=https://<your-supabase-project-ref>.supabase.co

# The service role secret key for your Supabase project (used for admin/backend actions)
# WARNING: Keep this key secure and do not commit real values to version control!
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# The anonymous database key (used as a fallback if service role key is not provided)
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Comma-separated list of origins allowed by CORS (e.g., dashboard frontend origin)
CORS_ALLOWED_ORIGINS=http://localhost:5173
