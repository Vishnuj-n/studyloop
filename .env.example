# LLM provider configuration
# FAST_LLM is used for quizzes and flashcards.
FAST_LLM_API_KEY=your_fast_api_key
FAST_LLM_BASE_URL=https://api.openai.com
FAST_LLM_MODEL=openai/gpt-oss-120b
FAST_LLM_TIMEOUT_MS=30000

# HEAVY_LLM is used for RAG, reader explanations, and syllabus drafting.
HEAVY_LLM_API_KEY=your_heavy_api_key
HEAVY_LLM_BASE_URL=https://api.openai.com
HEAVY_LLM_MODEL=openai/gpt-oss-120b
HEAVY_LLM_TIMEOUT_MS=30000

# Optional aliases supported by the app
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_TIMEOUT_MS=
# OPENAI_API_KEY=
# OPENAI_ENDPOINT=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# BASE_MODEL=
# API_KEY=
# BASE_URL=
# MODEL=
# TIMEOUT_MS=

# Cloud sync — the desktop app POSTs study data to this URL.
# Overrides whatever is stored in SQLite (useful for production deployments).
# CLOUD_SYNC_URL=https://your-backend.up.railway.app/api/sync
# CLOUD_API_TOKEN=your_secret_token

# Clerk authentication — the URL opened in the system browser when the student
# clicks "Sign In with Clerk" in Settings.
# CLERK_SIGN_IN_URL=https://your-clerk-app.accounts.dev/sign-in

