# Supabase Dev Environment variables for Cloud Portal Dashboard
# Note: Vite requires 'VITE_' prefix to expose variables to client-side code

# The URL of your Supabase project (e.g., https://xyz.supabase.co)
VITE_SUPABASE_URL=https://<your-supabase-project-ref>.supabase.co

# The anonymous public API key for your Supabase project
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Default/initial classroom code for student enrollment (e.g., BIO101)
VITE_CLASSROOM_CODE=BIO101
